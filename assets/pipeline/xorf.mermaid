flowchart LR

  %% ---------- Inputs ----------
  subgraph IN[Inputs]
    regions["Input regions"]
    sequence["Genome sequence"]
    database["Protein database"]
    seleno["Selenocysteine sites<br/>"]
  end

  %% ---------- Main processes ----------
  subgraph WF[XORF pipeline]
    GENEPRED_LINT["GENEPRED_LINT"]
    GENOMEMASK_SELENO["GENOMEMASK_SELENO<br/>"]
    CHUNKER["CHUNKER"]

    subgraph CAND[Candidate generation]
      TRANSLATIONAI["TRANSLATIONAI"]
      RNASAMBA["RNASAMBA"]
      NETSTART["NETSTART"]
      TRANSAID["TRANSAID"]
      JOIN["JOIN_NETS"]
      BLAST["BLAST"]
      PREDICT["PREDICT"]
    end

    CONCAT["CONCAT"]
    CONCAT_RAW["CONCAT_RAW<br/>(optional)"]
  end

  %% ---------- Outputs ----------
  subgraph OUT[Outputs]
    results["Final ORF results<br/>BED + TSV"]
    raw_results["Raw predictions<br/>BED + TSV"]
  end

  %% ---------- Input preparation ----------
  regions --> GENEPRED_LINT
  GENEPRED_LINT --> CHUNKER
  sequence -.-> GENOMEMASK_SELENO
  seleno -.-> GENOMEMASK_SELENO
  GENOMEMASK_SELENO -.-> CHUNKER

  %% ---------- Chunk pairing ----------
  CHUNKER --> TRANSLATIONAI
  CHUNKER --> RNASAMBA

  %% ---------- Candidate generation ----------
  RNASAMBA --> NETSTART
  RNASAMBA --> TRANSAID
  RNASAMBA --> JOIN
  NETSTART --> JOIN
  TRANSAID --> JOIN

  TRANSLATIONAI --> BLAST
  JOIN --> BLAST
  database --> BLAST

  BLAST --> PREDICT
  RNASAMBA --> PREDICT

  %% ---------- Final aggregation ----------
  PREDICT --> CONCAT
  PREDICT -.-> CONCAT_RAW

  CONCAT --> results
  CONCAT_RAW -.-> raw_results

  %% ---------- Styling ----------
  classDef input fill:#fff7e6,stroke:#b7791f,stroke-width:1px;
  classDef process fill:#eef5ff,stroke:#4a6fa5,stroke-width:1px;
  classDef output fill:#edfdfd,stroke:#0f766e,stroke-width:1px;
  classDef meta fill:#eefcf0,stroke:#2f855a,stroke-width:1px;
  classDef optional fill:#f7eefc,stroke:#805ad5,stroke-width:1px;

  class regions,sequence,database,seleno,weights_u,weights_l,email_in input;
  class WGET,GENEPRED_LINT,GENOMEMASK_SELENO,CHUNKER,TRANSLATION,RNASAMBA,NETSTART,TRANSAID,JOIN,BLAST,PREDICT,CONCAT,CONCAT_RAW process;
  class COUNTS,VERSIONS meta;
  class EMAIL optional;
  class results,raw_results,counts_out,versions_out output;
